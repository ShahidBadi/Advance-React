generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

/// Enums
enum UserType {
  Admin
  Student
  Librarian
}

enum TransactionStatus {
  BORROWED
  RETURNED
  OVERDUE
  LOST
  RENEWED
}

enum ReservationStatus {
  PENDING
  READY_FOR_PICKUP
  CANCELLED
  FULFILLED
}

enum requestaction{
    RESERVE
    RENEW
}

/// Models

model User {
  id                 String          @id @default(auto()) @map("_id") @db.ObjectId
  userFirstName      String
  userLastName       String
  userName           String          @unique
  userEmail          String          @unique
  userPassword       String
  userType           UserType
  membershipDate     DateTime        @default(now())
  isBlocked          Boolean         @default(false)

  // relations
  transactions       Transaction[]
  reservations       Reservation[]
  borrows            Borrow[]
  notifications      Notification[]  @relation("UserNotifications")

  // admin / audit
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model Book {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  author       String
  isbn         String?
  type         String?          // e.g. "Fiction", "Reference"
  quantity     Int              @default(1)
  available    Int              @default(1)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // relations
  transactions Transaction[]
  reservations Reservation[]
  borrows      Borrow[]
}

model Transaction {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  trxNumber     String            @unique            // e.g. TRX-00125
  bookId        String            @db.ObjectId
  memberId      String            @db.ObjectId
  book          Book              @relation(fields: [bookId], references: [id])
  member        User              @relation(fields: [memberId], references: [id])
  status        TransactionStatus @default(BORROWED)
  issuedAt      DateTime          @default(now())
  dueAt         DateTime
  returnedAt    DateTime?
  renewedCount  Int               @default(0)
  fineAmount    Float?            @default(0.0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  notifications Notification[]    @relation("TransactionNotifications")

  // Useful indexes
  @@index([memberId])
  @@index([bookId])
}

model Reservation {
  id                String            @id @default(auto()) @map("_id") @db.ObjectId
  reservationNumber String            @unique
  bookId            String            @db.ObjectId
  memberId          String            @db.ObjectId
  book              Book              @relation(fields: [bookId], references: [id])
  member            User              @relation(fields: [memberId], references: [id])
  status            ReservationStatus @default(PENDING)
  reservedAt        DateTime          @default(now())
  expiresAt         DateTime?         // date until which reservation is valid
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

    notifications     Notification[]

  @@index([memberId])
  @@index([bookId])
}

model Borrow {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  bookId     String   @db.ObjectId
  memberId   String   @db.ObjectId
  book       Book     @relation(fields: [bookId], references: [id])
  member     User     @relation(fields: [memberId], references: [id])
  borrowedAt DateTime @default(now())
  dueDate    DateTime
  returnedAt DateTime?
  status     String   @default("BORROWED") // BORROWED | RETURNED | OVERDUE

  @@index([bookId])
  @@index([memberId])
}

model Notification {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  type          String
  message       String
  status        String        @default("PENDING")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  action        requestaction

  // Relations
  memberId      String
  member        User          @relation("UserNotifications", fields: [memberId], references: [id])

  transactionId String?       // optional
  transaction   Transaction?  @relation("TransactionNotifications", fields: [transactionId], references: [id])

  reservationId String?       // optional
  reservation   Reservation?  @relation(fields: [reservationId], references: [id])
}

